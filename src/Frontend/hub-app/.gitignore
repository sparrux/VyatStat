/dist/
/tmp/
/out-tsc/
/bazel-out

# Angular CLI cache and build artifacts
/.angular/
.angular/

# Node
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tgz
.npm
.pnpm-store

# TypeScript
*.tsbuildinfo

# Testing
/coverage/
*.lcov
.nyc_output
/e2e/test-output/
test-results/
playwright-report/
playwright/.cache/
blob-report/
__screenshots__/

# Linting
.eslintcache
.stylelintcache

# Environment variables
.env
.env.*
!.env.example

# IDEs and editors
.idea/
*.iml
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

